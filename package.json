{
  "name": "weave",
  "version": "0.1.0",
  "description": "Ultra-lightweight Claude Code extension, MCP server and visual dashboard that routes active features and severs idle context cords.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xTycho/WEAVE.git"
  },
  "keywords": [
    "claude",
    "claude-code",
    "mcp",
    "context",
    "react-flow",
    "prompt"
  ],
  "bin": {
    "weave": "bin/weave.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "bin",
    "dist",
    "src/ui/dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:ui",
    "build:server": "tsc -p tsconfig.json",
    "build:ui": "vite build --config src/ui/vite.config.ts",
    "dev:ui": "vite --config src/ui/vite.config.ts",
    "prepare": "tsc -p tsconfig.json",
    "start": "node bin/weave.js ui",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/ui/tsconfig.json",
    "test": "npm run build:server && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@xyflow/react": "^12.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
