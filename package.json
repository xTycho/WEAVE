{
  "name": "weave",
  "version": "0.3.0",
  "description": "A local map of your project for Claude Code: it splits the project into areas, writes a small subagent for each, and tells you when to /compact or /clear. Fixed rules, no AI.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xTycho/WEAVE.git"
  },
  "keywords": [
    "claude",
    "claude-code",
    "claude-desktop",
    "mcp",
    "context",
    "subagents"
  ],
  "bin": {
    "weave": "bin/weave.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "bin",
    "dist",
    "src/ui/dist",
    "mods",
    "templates",
    "README.md",
    "AI_SETUP.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:ui",
    "build:server": "tsc -p tsconfig.json",
    "build:ui": "vite build --config src/ui/vite.config.ts",
    "dev:ui": "vite --config src/ui/vite.config.ts",
    "prepare": "tsc -p tsconfig.json",
    "start": "node bin/weave.js ui",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/ui/tsconfig.json",
    "test": "npm run build:server && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/righteous": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "thinking-orbs": "^0.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
